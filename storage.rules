rules_version = '2';

// Solo se suben imágenes bajo glazes/. Cualquier otro camino queda cerrado
// para que este bucket no sirva de almacenamiento libre.
service firebase.storage {
  match /b/{bucket}/o {
    match /glazes/{allPaths=**} {
      allow read: if request.auth != null;

      // El límite de 5 MB nunca se alcanza porque la app comprime a JPEG antes
      // de subir, pero evita que alguien guarde un archivo arbitrario enorme.
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
