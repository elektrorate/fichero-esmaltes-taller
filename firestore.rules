rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /glazes/{glazeId} {
      allow read, write: if request.auth != null;

      match /comments/{commentId} {
        allow read, write: if request.auth != null;
      }
    }

    match /invites/{email} {
      allow read, write: if request.auth != null;
    }
  }
}
